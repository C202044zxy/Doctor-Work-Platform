# Docker Compose only. Local demo credentials; change for shared environments.
MYSQL_DATABASE=doctor_platform
MYSQL_USER=doctor
MYSQL_PASSWORD=doctor_local_password
MYSQL_ROOT_PASSWORD=root_local_password

# HS256 signing key, and the HMAC key for verification codes: changing it invalidates
# every issued token and every code already sent. Required, 32+ characters; the backend
# rejects sign-in with 503 while it is empty. Change it outside local development.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-jwt-secret-for-local-runs

SMTP_TIMEOUT=10
OTP_DAILY_LIMIT=20
