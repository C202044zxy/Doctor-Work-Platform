# Local development; relative to backend/.
DATABASE_URL=sqlite:///./doctor.db
# Optional locally; required and configured automatically in Docker Compose.
# REDIS_URL=redis://127.0.0.1:6379/0

# AES-256 key material for the patient phone and ID columns (T13). Change it
# outside local development; every backend process must use the same value.
PATIENT_DATA_KEY=dev-only-insecure-patient-data-key

# T05: Redis is required for authentication, tickets and token revocation.
# MySQL example (credentials belong only in the ignored .env):
# DATABASE_URL=mysql+pymysql://doctor:CHANGE_ME@127.0.0.1:3306/doctor?charset=utf8mb4
JWT_SECRET=
# T10: one scan per worker each minute; conditional updates prevent duplicate audits.
SCHEDULER_ENABLED=true

# Generate JWT_SECRET locally (32+ random characters).
SMTP_TIMEOUT=10
OTP_DAILY_LIMIT=20
